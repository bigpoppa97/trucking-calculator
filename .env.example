# HERE Routing API key — SERVER-SIDE ONLY, never expose to the client bundle.
# The server refuses to start without it.
HERE_API_KEY=your-here-api-key

# SQLite database file (created on first run)
DATABASE_PATH=data/calculator.sqlite

# HTTP server binding
PORT=3001
HOST=127.0.0.1

# Tablica floty (board)
# Name stored with notes and manual corrections made on the board
BOARD_USER=kierownik
# Set to "off" to never call HERE for board kilometres (estimates only)
# BOARD_HERE=off
