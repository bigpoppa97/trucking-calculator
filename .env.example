# HERE Routing API key — SERVER-SIDE ONLY, never expose to the client bundle.
# The server refuses to start without it.
HERE_API_KEY=your-here-api-key

# SQLite database file (created on first run).
# docker-compose overrides this to /data/calculator.sqlite (named volume).
DATABASE_PATH=data/calculator.sqlite

# HTTP server binding. In docker-compose HOST is overridden to 0.0.0.0.
PORT=3001
HOST=127.0.0.1

# Vite dev-server proxy target for /api (web/vite.config.ts).
# Defaults to http://127.0.0.1:3001; docker-compose sets http://backend:3001.
#API_PROXY_TARGET=http://127.0.0.1:3001

# Set to true when the app is served over HTTPS (tunnel/reverse proxy) —
# marks the session cookie Secure.
COOKIE_SECURE=false

# Built frontend directory; when it exists the server serves the SPA from
# the same port as /api (run `npm run build` in web/ first).
WEB_DIST=web/dist
